---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1b1b19" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Rishabh Agarwal — software and ML engineer. Portfolio, projects, and research." />
    <title>Rishabh Agarwal — Software / ML Engineer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;500;700&family=Caveat:wght@500;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --cream: #f2f0ea;
        --ink: #1b1b19;
        --ink-90: #1b1b19e6;
        --ink-70: #1b1b19b3;
        --ink-55: #1b1b198c;
        --ink-40: #1b1b1966;
        --ink-25: #1b1b1940;
        --ink-15: #1b1b1925;
        --ink-08: #1b1b1918;
        --orange: oklch(0.6 0.2 35);
        --orange-light: oklch(0.72 0.17 35);
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: var(--cream); color: var(--ink); }
      body {
        font-family: 'Hanken Grotesk', system-ui, sans-serif;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      .mono { font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace; }
      .archivo { font-family: 'Archivo', system-ui, sans-serif; font-stretch: 78%; }
      .caveat { font-family: 'Caveat', cursive; }

      /* Blueprint backgrounds */
      .bp {
        background-image:
          linear-gradient(#1b1b190d 1px, transparent 1px),
          linear-gradient(90deg, #1b1b190d 1px, transparent 1px);
        background-size: 40px 40px;
      }
      .bp-fine {
        background-image:
          linear-gradient(#1b1b190f 1px, transparent 1px),
          linear-gradient(90deg, #1b1b190f 1px, transparent 1px);
        background-size: 16px 16px;
      }
      .bp-mid {
        background-image:
          linear-gradient(#1b1b190d 1px, transparent 1px),
          linear-gradient(90deg, #1b1b190d 1px, transparent 1px);
        background-size: 32px 32px;
      }
      .rule-top::before {
        content: '';
        position: absolute; left: 0; right: 0; top: 0; height: 8px;
        background: repeating-linear-gradient(90deg, #1b1b1955 0 1px, transparent 1px 8px);
      }

      /* Layout */
      .frame { display: grid; min-height: 100vh; grid-template-columns: 310px 1fr; padding: 10px; gap: 0; }

      /* Rail */
      .rail {
        border: 1px solid var(--ink-25);
        display: flex; flex-direction: column;
        position: sticky; top: 10px; align-self: start;
        height: calc(100vh - 20px);
        overflow: hidden;
      }
      .rail-head {
        display: flex; align-items: center; gap: 10px;
        padding: 14px 18px; border-bottom: 1px solid var(--ink-25);
      }
      .rail-logo {
        width: 26px; height: 26px; border: 1.5px solid var(--ink);
        display: grid; place-items: center;
        font: 700 11px 'JetBrains Mono', monospace;
        clip-path: polygon(0 0, 75% 0, 100% 25%, 100% 100%, 0 100%);
      }
      .rail-sheet {
        font: 500 10px 'JetBrains Mono', monospace;
        letter-spacing: .08em; color: var(--ink-55);
      }
      .rail-portrait-wrap {
        padding: 18px; position: relative; border-bottom: 1px solid var(--ink-25);
      }
      .rail-portrait {
        position: relative; height: 250px; border: 1px solid var(--ink-40);
        background: var(--cream); overflow: hidden;
      }
      .rail-portrait img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
      .crosshair { position: absolute; font: 300 14px monospace; }
      .sticker {
        position: absolute; transform: rotate(8deg); background: var(--orange);
        color: #fff; font: 700 30px/1 'Caveat', cursive;
        height: 40px; padding: 0 18px 0 10px;
        display: flex; align-items: center;
        box-shadow: 2px 3px 0 var(--ink);
      }
      .fig-caption {
        margin-top: 8px; display: flex; justify-content: space-between;
        font: 500 9.5px 'JetBrains Mono', monospace; color: var(--ink-55);
      }
      .rail-name-wrap { padding: 18px 18px 16px; border-bottom: 1px solid var(--ink-25); }
      .rail-name {
        font-family: 'Archivo', sans-serif;
        font-weight: 800;
        font-size: 40px;
        line-height: .9;
        font-stretch: 78%;
        text-transform: uppercase;
        letter-spacing: -.01em;
      }
      .rail-role {
        margin-top: 8px; font: 500 11px 'JetBrains Mono', monospace;
        letter-spacing: .06em; color: var(--orange);
      }
      .rail-degrees {
        padding: 16px 18px; border-bottom: 1px solid var(--ink-25);
        display: flex; flex-direction: column; gap: 12px;
      }
      .degree-title { font: 700 14px 'Archivo', sans-serif; }
      .degree-meta { font: 500 11px 'JetBrains Mono', monospace; color: var(--ink-55); margin-top: 2px; }
      .rail-links { display: flex; flex-direction: column; font: 500 11.5px 'JetBrains Mono', monospace; letter-spacing: .04em; }
      .rail-links a {
        display: flex; justify-content: space-between; padding: 11px 18px;
        border-bottom: 1px solid var(--ink-15);
      }
      .rail-links a span:last-child { color: var(--ink-55); }
      .rail-email {
        margin-top: auto; display: flex; justify-content: space-between; align-items: center;
        padding: 14px 18px; background: var(--ink); color: var(--cream);
        font: 500 11.5px 'JetBrains Mono', monospace; letter-spacing: .04em;
      }
      .rail-email .arrow { color: var(--orange-light); }

      /* Main column */
      .main {
        border: 1px solid var(--ink-25); border-left: 0;
        display: flex; flex-direction: column; min-width: 0;
        min-height: calc(100vh - 20px);
      }
      .top-nav {
        display: grid; grid-template-columns: 1fr repeat(4, 120px);
        border-bottom: 1px solid var(--ink-25);
      }
      .crumb {
        padding: 14px 20px; font: 500 11px 'JetBrains Mono', monospace;
        color: var(--ink-55); letter-spacing: .06em;
        display: flex; align-items: center;
      }
      .top-nav button {
        border: 0; border-left: 1px solid var(--ink-25);
        padding: 14px 12px; background: transparent;
        font: 500 11px 'JetBrains Mono', monospace; letter-spacing: .06em;
        color: var(--ink); cursor: pointer;
      }
      .top-nav button.active { background: var(--ink); color: var(--cream); }

      /* Panels */
      .panels { flex: 1; min-height: 0; min-width: 0; }
      .panel { display: none; }
      .panel.active { display: block; }

      /* Home */
      .hero {
        border-bottom: 1px solid var(--ink-25); position: relative;
      }
      .hero-label { padding: 44px 24px 20px; }
      .section-label {
        font: 500 11px 'JetBrains Mono', monospace;
        letter-spacing: .08em; color: var(--ink-55);
      }
      .hero-title {
        margin: 0; padding: 0 24px 34px;
        font-family: 'Archivo', sans-serif;
        font-weight: 800;
        font-size: 72px;
        line-height: .88;
        font-stretch: 78%;
        letter-spacing: -.02em;
        text-transform: uppercase;
      }
      .squiggle-word { position: relative; display: inline-block; }
      .squiggle-word svg { position: absolute; left: -8px; bottom: -12px; width: 110%; height: 18px; }

      .about-interests { display: grid; grid-template-columns: 1fr 320px; border-bottom: 1px solid var(--ink-25); }
      .about { padding: 24px 28px 28px; }
      .about p { margin: 12px 0 0; font-size: 16px; line-height: 1.65; color: var(--ink-90); max-width: 620px; text-wrap: pretty; }
      .interests { border-left: 1px solid var(--ink-25); padding: 24px 22px; position: relative; }
      .interest-row {
        display: grid; grid-template-columns: 34px 1fr; gap: 4px 0;
        padding: 14px 0; border-top: 1px solid var(--ink-15);
      }
      .interests .section-label { margin-bottom: 10px; }
      .interest-num { font: 500 11px 'JetBrains Mono', monospace; color: var(--orange); padding-top: 3px; }
      .interest-title { font: 700 17px 'Archivo', sans-serif; }
      .interest-desc { grid-column: 2; font-size: 13.5px; line-height: 1.45; color: var(--ink-70); }
      .caveat-note {
        transform: rotate(-4deg); font: 700 21px 'Caveat', cursive; color: var(--orange);
      }

      .toolkit { padding: 20px 24px 28px; }
      .toolkit-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }
      .toolkit-row {
        display: grid; grid-template-columns: 150px 1fr; gap: 14px;
        padding: 8px 0; align-items: baseline;
        border-top: 1px solid var(--ink-08);
      }
      .toolkit-row:first-of-type { border-top: 0; }
      .toolkit-label {
        font: 500 11px 'JetBrains Mono', monospace;
        letter-spacing: .06em; color: var(--ink-55);
      }
      .chips { display: flex; flex-wrap: wrap; gap: 4px 5px; font: 500 11px/1.4 'JetBrains Mono', monospace; }
      .chip { border: 1px solid var(--ink-40); padding: 2px 7px; background: var(--cream); }

      /* Section title header (used for Work/Projects/Research) */
      .section-head {
        display: flex; justify-content: space-between; align-items: baseline;
        gap: 16px; flex-wrap: wrap;
        padding: 30px 20px 18px;
        border-bottom: 1px solid var(--ink-25);
        position: relative;
      }
      .section-title {
        font-family: 'Archivo', sans-serif;
        font-weight: 800;
        font-size: 34px;
        font-stretch: 80%;
        text-transform: uppercase;
      }
      .section-tag { font: 700 22px 'Caveat', cursive; color: var(--orange); transform: rotate(-2deg); }
      .work-head-inner { display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap; }
      .work-tag .ar-down { display: none; }
      .sheet-num { font: 500 11px 'JetBrains Mono', monospace; color: var(--ink-55); }

      /* Work rows */
      .work-row {
        display: grid; grid-template-columns: 160px 1fr 1.3fr;
        border-bottom: 1px solid var(--ink-15);
      }
      .work-row .cell { padding: 20px; }
      .work-row .cell + .cell { border-left: 1px solid var(--ink-15); }
      .work-range { font: 500 12px 'JetBrains Mono', monospace; color: var(--ink-70); }
      .work-role { font: 700 18px 'Archivo', sans-serif; }
      .work-org { font: 500 12px 'JetBrains Mono', monospace; color: var(--ink-55); margin-top: 4px; }
      .work-body { font-size: 14.5px; line-height: 1.5; color: var(--ink-70); }

      /* Projects */
      .projects {
        display: grid; grid-template-columns: repeat(3, 1fr);
      }
      .project { padding: 18px; display: flex; flex-direction: column; gap: 12px; }
      .project + .project { border-left: 1px solid var(--ink-25); }
      .project-media {
        height: 200px; border: 1px solid var(--ink-40); overflow: hidden;
        background: #fff; position: relative;
      }
      .project-media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
      .project-title {
        font-family: 'Archivo', sans-serif;
        font-weight: 800;
        font-size: 22px;
        line-height: 1;
        font-stretch: 85%;
        text-transform: uppercase;
      }
      .project-sub {
        font: 500 11px 'JetBrains Mono', monospace; color: var(--orange); margin-top: -6px;
      }
      .project-sub.muted { color: var(--ink-55); }
      .project-desc { font-size: 14px; line-height: 1.45; color: var(--ink-70); }

      .terminal {
        height: 200px; background: var(--ink); color: var(--cream);
        overflow: hidden; position: relative;
        display: flex; flex-direction: column;
        font: 500 10.5px/1.6 'JetBrains Mono', monospace;
        background-image: repeating-linear-gradient(0deg, #ffffff06 0 1px, transparent 1px 3px);
      }
      .terminal .tab {
        display: flex; align-items: center; gap: 8px; padding: 6px 10px;
        border-bottom: 1px solid #ffffff1a; color: #f2f0ea77; font-size: 9.5px;
      }
      .terminal .diamond { width: 7px; height: 7px; border: 1px solid #f2f0ea66; transform: rotate(45deg); }
      .terminal .body { padding: 8px 12px; flex: 1; display: flex; flex-direction: column; gap: 1px; }
      .terminal .muted { color: #f2f0ea88; }
      .terminal .err { color: var(--orange-light); }
      .confidential {
        margin-top: auto; align-self: center; margin-bottom: 10px;
        border: 1.5px solid var(--orange-light); color: var(--orange-light);
        padding: 5px 12px; text-align: center; transform: rotate(-3deg);
      }
      .confidential .big {
        font-family: 'Archivo', sans-serif;
        font-weight: 800;
        font-size: 17px;
        line-height: 1.1;
        font-stretch: 85%;
        letter-spacing: .12em;
      }
      .confidential .small { font-size: 9.5px; letter-spacing: .1em; }

      .stack-footer {
        border-top: 1px solid var(--ink-25); padding: 22px;
        display: grid; grid-template-columns: 130px 1fr; row-gap: 10px;
        font: 500 12.5px/1.5 'JetBrains Mono', monospace;
      }
      .stack-footer .k { color: var(--ink-55); }

      /* Research */
      .pub {
        padding: 28px 24px; border-bottom: 1px solid var(--ink-25);
        display: grid; grid-template-columns: 60px 1fr; gap: 14px;
      }
      .pub-num { font: 500 12px 'JetBrains Mono', monospace; color: var(--ink-55); }
      .pub-title { font: 700 22px/1.25 'Archivo', sans-serif; max-width: 720px; }
      .pub-authors { margin-top: 8px; font-size: 14.5px; color: var(--ink-70); }
      .pub-name-hi {
        position: relative; font-weight: 600; color: var(--ink);
      }
      .pub-name-hi svg { position: absolute; left: -6px; bottom: -6px; width: calc(100% + 12px); height: 10px; }
      .pub-links { margin-top: 12px; display: flex; gap: 16px; font: 500 11px 'JetBrains Mono', monospace; color: var(--orange); }
      .research-heading {
        padding: 18px 24px 6px; font: 500 11px 'JetBrains Mono', monospace;
        letter-spacing: .08em; color: var(--ink-55); border-top: 1px solid var(--ink-15);
      }
      .research-row {
        display: grid; grid-template-columns: 160px 1fr;
        border-top: 1px solid var(--ink-15); position: relative;
      }
      .research-row .range {
        padding: 20px; font: 500 12px/1.5 'JetBrains Mono', monospace; color: var(--ink-70);
      }
      .research-row .body { padding: 20px 24px 20px 20px; border-left: 1px solid var(--ink-15); }
      .research-row .role { font: 700 18px 'Archivo', sans-serif; }
      .research-row .org {
        font: 500 11.5px/1.5 'JetBrains Mono', monospace; color: var(--ink-55); margin-top: 4px;
      }
      .research-row .pi { color: var(--ink-70); }
      .research-row ul { margin: 12px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 7px; }
      .research-row li {
        display: grid; grid-template-columns: 16px 1fr;
        font-size: 14.5px; line-height: 1.5; color: var(--ink-70);
        max-width: 720px; text-wrap: pretty;
      }
      .research-row li .bullet {
        color: var(--orange); font: 500 11px 'JetBrains Mono', monospace; padding-top: 3px;
      }
      .row-tag {
        position: absolute; right: 22px; top: 14px; transform: rotate(4deg);
        font: 700 21px 'Caveat', cursive; color: var(--orange); pointer-events: none;
      }

      /* Mobile-only header + bottom nav + identity card */
      .m-header, .m-tabbar, .m-identity { display: none; }

      /* Responsive */
      @media (max-width: 900px) {
        .frame { grid-template-columns: 1fr; padding: 0; }
        .rail { display: none; }
        .main { border: 0; min-height: 100vh; }
        .top-nav { display: none; }

        .m-header {
          display: flex; align-items: center; gap: 10px;
          padding: 10px 14px;
          background: var(--cream);
          border-bottom: 1px solid var(--ink-25);
          position: sticky; top: 0; z-index: 5;
        }
        .m-avatar {
          width: 40px; height: 40px; border: 1px solid var(--ink-40);
          overflow: hidden; flex: none;
        }
        .m-avatar img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; }
        .m-name-wrap { flex: 1; min-width: 0; }
        .m-name {
          font-family: 'Archivo', sans-serif;
          font-weight: 800;
          font-size: 20px;
          line-height: .95;
          font-stretch: 78%;
          text-transform: uppercase;
        }
        .m-role {
          font: 500 9.5px 'JetBrains Mono', monospace;
          letter-spacing: .06em; color: var(--orange); margin-top: 3px;
        }
        .m-email-btn {
          flex: none; width: 44px; height: 44px;
          display: grid; place-items: center;
          background: var(--ink); color: var(--cream);
          font: 500 14px 'JetBrains Mono', monospace;
        }

        /* Identity card at top of each screen */
        .m-identity {
          display: block;
          padding: 18px;
          border-bottom: 1px solid var(--ink-25);
        }
        .m-portrait {
          position: relative; width: 300px; aspect-ratio: 1;
          margin: 0 auto;
          border: 1px solid var(--ink-40);
          background: var(--cream); overflow: hidden;
        }
        .m-identity .sticker {
          right: 34px; top: 36px;
          height: 46px; font-size: 34px;
          padding: 0 20px 0 12px;
        }
        .m-portrait img {
          display: block; width: 100%; height: 100%;
          object-fit: cover; object-position: center 30%;
        }
        .m-degrees {
          display: grid; grid-template-columns: 1fr 1fr;
          border: 1px solid var(--ink-25); background: var(--cream);
        }
        .m-degrees > div { padding: 10px 12px; }
        .m-degrees > div + div { border-left: 1px solid var(--ink-25); }
        .m-degrees .title { font: 700 13px/1.25 'Archivo', sans-serif; }
        .m-degrees .meta { font: 500 10px 'JetBrains Mono', monospace; color: var(--ink-55); margin-top: 4px; }
        .m-links {
          display: grid; grid-template-columns: repeat(3, 1fr);
          border: 1px solid var(--ink-25); border-top: 0; background: var(--cream);
          font: 500 11px 'JetBrains Mono', monospace; letter-spacing: .04em;
        }
        .m-links a {
          height: 44px; display: flex; align-items: center; justify-content: center; gap: 5px;
        }
