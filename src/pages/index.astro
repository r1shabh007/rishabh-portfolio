    <script>
      (function () {
        const buttons = document.querySelectorAll('button.nav-btn');
        const panels = document.querySelectorAll('.panel');
        const crumb = document.getElementById('crumb');

        function activate(target: string) {
          buttons.forEach((b) => {
            const el = b as HTMLElement;
            el.classList.toggle('active', el.dataset.target === target);
          });
          panels.forEach((p) => {
            p.classList.toggle('active', p.id === `panel-${target}`);
          });
          if (crumb) crumb.textContent = `~/ ${target}`;
          if (history.replaceState) {
            history.replaceState(null, '', `#${target}`);
          }
          window.scrollTo({ top: 0 });
        }

        buttons.forEach((b) => {
          b.addEventListener('click', () => {
            const target = (b as HTMLElement).dataset.target;
            if (target) activate(target);
          });
        });

        const valid = ['home', 'work', 'projects', 'research'];
        const readHash = () => (window.location.hash || '#home').replace('#', '');
        const initial = readHash();
        if (valid.includes(initial)) activate(initial);

        window.addEventListener('hashchange', () => {
          const h = readHash();
          if (valid.includes(h)) activate(h);
        });
      })();
    </script>
